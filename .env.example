# ===== 部署环境 =====
# development（缺省）/ preview / staging / production
# preview 与 development 下支付与 AI 计费被强制 fail-closed（无论下方开关怎么配）
APP_ENV=development

# 部署版本号（平台自动注入：Render=RENDER_GIT_COMMIT；手动部署可自设）
COMMIT_SHA=

# 服务端口（Render 等平台自动注入 PORT，缺省 3000）
PORT=3000

# ===== 支付总闸（fail-closed） =====
# 仅当 APP_ENV=staging|production 且此处显式为 true 才开放充值；
# preview/development 下强制关闭。支付渠道未接入前保持 false。
PAYMENT_ENABLED=false

# ===== AI 计费闸（fail-closed） =====
# staging/production 缺省 true（live 参详成功扣 1 灵签）；
# preview/development 强制免费。显式 false 可关闭扣费。
AI_BILLING_ENABLED=true

# ===== OAuth 应用（门户申请；preview 环境请使用独立的 preview 应用） =====
APP_ID=
APP_SECRET=
VITE_APP_ID=
VITE_KIMI_AUTH_URL=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=

# ===== 数据库（MySQL；preview 使用独立数据库，公网连接强制 TLS） =====
# 格式：mysql://user:password@host:port/database
DATABASE_URL=

# ===== AI 参详适配器（OpenAI 兼容协议） =====
# 未配置 AI_API_KEY 时自动降级为模板引擎（接口契约不变，source=fallback，免费）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# CORS 跨域白名单（逗号分隔；同源部署留空即可，默认不放行任何跨域）
# CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
